# Production environment variables for Vercel deployment
# Note: These are used during build time on Vercel

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Supabase project URL (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase anon key (safe for client-side — RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Supabase service-role key (SERVER ONLY — bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection for Drizzle migrations
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ============================================================================
# PI NETWORK RPC ENDPOINTS
# ============================================================================
# Mainnet RPC Endpoint
NEXT_PUBLIC_PI_RPC_MAINNET=https://rpc.minepi.com
# Testnet RPC Endpoint
NEXT_PUBLIC_PI_RPC_TESTNET=https://rpc.testnet.minepi.com
# RPC Timeout (ms)
NEXT_PUBLIC_PI_RPC_TIMEOUT=30000
# RPC Retry Attempts
NEXT_PUBLIC_PI_RPC_RETRIES=3

# ============================================================================
# HORIZON DATA LAYER (External Data & Structure)
# ============================================================================
# Horizon API endpoint for data and structure access
NEXT_PUBLIC_HORIZON_ENDPOINT=https://horizon.com/api/v1
HORIZON_API_KEY=your-horizon-api-key

# ============================================================================
# EXTERNAL API BRIDGE (Outside World Connectivity)
# ============================================================================
# External API endpoint for bridging to outside world services
NEXT_PUBLIC_EXTERNAL_API_ENDPOINT=https://api.triumph-synergy.pi

# ============================================================================
# MAINNET CONFIGURATION (App URL = Vercel, Dev URL = Pinet)
# ============================================================================
NEXT_PUBLIC_PI_APP_ID=triumph-synergy
NEXT_PUBLIC_PI_SANDBOX=false
NEXT_PUBLIC_PI_BROWSER_DETECTION=true
# Pi App Studio assigns a fresh canonical hostname on every (re)transfer.
# Override these in your hosting provider's env (e.g. Pi App Studio's project
# env, or a docker-compose .env) with the new domain. Leaving them blank
# falls back to localhost for safe local builds.
NEXT_PUBLIC_APP_URL=
NEXTAUTH_URL=
NEXT_PUBLIC_PI_DEV_URL_MAINNET=

# ---------------------------------------------------------------------------
# PI NODE ADDRESSING (app -> blockchain node)
# ---------------------------------------------------------------------------
# Set this to the hostname/IP where the Pi node's RPC + Horizon are reachable
# from the running app process. Examples:
#   * App in same docker-compose as triumph-pi-mainnet-node:
#       PI_NODE_ROOT_HOST=triumph-pi-mainnet-node
#   * App on macOS host, Pi Desktop running locally:
#       PI_NODE_ROOT_HOST=host.docker.internal
#   * App in Pi App Studio / production with no local node:
#       PI_NODE_ROOT_HOST=api.mainnet.minepi.com
# Leaving blank marks the node "unconfigured" and the app will refuse to
# proxy chain calls (intentional safety guard).
PI_NODE_ROOT_HOST=host.docker.internal
PI_NODE_ROOT_REGION=us-east-1
PI_NODE_VERSION_DISPLAY=5.4
# Comma-separated TCP ports the app should advertise for this root node.
# Default mirrors Pi Desktop mainnet container layout (Horizon, peer, history,
# stellar-core HTTP, plus reserved range 31404-31409 for additional services).
PI_NODE_ROOT_PORTS=31501,31502,31503,31500,31404,31405,31406,31407,31408,31409

# Mainnet Pi Network Validation Key (DO NOT HARDCODE IN CODE)
PI_NETWORK_MAINNET_VALIDATION_KEY=efee2c5a2ce4e5079efeb7eb88e9460f8928f87e900d1fb2075b3f6279fb5b612550875c1fb8b0f1b749b96028e66c833bfc6e52011997a4c38d3252e7b2b195

# ============================================================================
# TESTNET CONFIGURATION
# ============================================================================
# Testnet Pi Network Validation Key (DO NOT HARDCODE IN CODE)
PI_NETWORK_TESTNET_VALIDATION_KEY=75b333f8b28771b24f2fb6adb87b225cc1b58eef8bd5a747d388a98dca1084e331eebc385c6a63885a887f4a0382bc883adeeeccdce9240b4cb8c10faaed93a3