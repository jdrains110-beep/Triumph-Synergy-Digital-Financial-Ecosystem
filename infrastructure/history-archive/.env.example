# Copy this file to .env and fill in values; never commit the real .env.
# Used by provision-history-archive.sh to bootstrap the public history bucket.

# --- Cloudflare R2 (recommended — zero egress cost) ---
# Get from: Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create
# (token type: Object Read & Write, scoped to bucket triumph-synergy-history)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
S3_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com

# --- AWS S3 alternative ---
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# (omit S3_ENDPOINT for native AWS)

BUCKET=triumph-synergy-history
