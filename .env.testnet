# --- Network Mode ---
PI_NETWORK_MODE=testnet
NEXT_PUBLIC_PI_SANDBOX=true
NEXT_PUBLIC_PI_APP_ID=triumph-synergy

# --- Database ---
POSTGRES_DB=triumph_synergy
POSTGRES_PASSWORD=triumph_secure_2026
POSTGRES_PORT=5433
REDIS_PORT=6380

# --- Auth ---
AUTH_SECRET=triumph-synergy-auth-secret-32chars-minimum-key
NEXTAUTH_SECRET=triumph-synergy-nextauth-secret-32chars-min
NEXTAUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000/api

# --- Pi Network (Testnet) ---
PI_API_KEY=
PI_INTERNAL_API_KEY=
PI_API_URL=https://api.testnet.minepi.com
PI_NETWORK_TESTNET_VALIDATION_KEY=75b333f8b28771b24f2fb6adb87b225cc1b58eef8bd5a747d388a98dca1084e331eebc385c6a63885a887f4a0382bc883adeeeccdce9240b4cb8c10faaed93a3

# --- Pi Node Docker Container ---
PI_NODE_CONTAINER=testnet2
