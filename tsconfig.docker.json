{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "isolatedModules": true
  },
  "include": [
    "lib/pi-transaction/**/*.ts",
    "lib/stellar/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
