# ─── SUPABASE ────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── OPENAI (for embeddings in persistent-memory) ────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── GITHUB (for meta-builder PR creation) ───────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=jdrains110-beep
GITHUB_REPO=Triumph-Synergy-Digital-Financial-Ecosystem-main

# ─── REDIS (hot cache for v5) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── AWS S3 (version snapshots & backups) ─────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=triumph-saib-versions
AWS_REGION=us-east-1

# ─── APPLICATION SETTINGS ─────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── LOGGING & METRICS ────────────────────────────────────────────────────
ENABLE_METRICS_EXPORT=true
METRICS_EXPORT_INTERVAL=60000
LOG_LEVEL=debug

# ─── AUTONOMOUS LOOP SETTINGS ─────────────────────────────────────────────
# Tick interval in milliseconds (30s = 30000ms)
AUTONOMOUS_TICK_INTERVAL_MS=30000
AUTONOMOUS_LOOP_ENABLED=true

# ─── V5 ORCHESTRATOR SETTINGS ─────────────────────────────────────────────
# Autonomous action risk thresholds
V5_LOW_RISK_THRESHOLD=0.3
V5_HIGH_RISK_THRESHOLD=0.7
# Target autonomous decision rate (80% = 0.8)
V5_TARGET_AUTONOMOUS_RATE=0.8

# ─── LIQUIDITY ORCHESTRATOR SETTINGS ──────────────────────────────────────
# GCV target peg (in cents, so 314159 = $31,415.90)
GCV_TARGET_CENTS=31415900
# GCV peg tolerance (in cents)
GCV_TOLERANCE_CENTS=10000
# Enable arbitrage cycles
GCV_ARBITRAGE_ENABLED=true

# ─── META-BUILDER SETTINGS (V10) ──────────────────────────────────────────
# Mutation generation interval (7 days = 604800000ms)
META_BUILDER_MUTATION_INTERVAL_MS=604800000
# Only auto-merge if risk score < 0.2
META_BUILDER_AUTO_MERGE_RISK_THRESHOLD=0.2

# ─── GOVERNANCE SETTINGS (V10) ────────────────────────────────────────────
# Proposal voting duration (7 days)
GOVERNANCE_VOTING_DURATION_MS=604800000
# Quorum for proposals (10000 votes)
GOVERNANCE_QUORUM_VOTERS=10000
# Approval threshold (66%)
GOVERNANCE_APPROVAL_THRESHOLD=0.66

# ─── WITNESS NETWORK SETTINGS (V10) ───────────────────────────────────────
# BFT consensus timeout (10 seconds)
WITNESS_CONSENSUS_TIMEOUT_MS=10000
# Target validator count (10K)
WITNESS_TARGET_VALIDATORS=10000
# Reputation penalty for misbehavior
WITNESS_SLASH_PENALTY=10

# ─── SDK SETTINGS ─────────────────────────────────────────────────────────
SDK_API_BASE_URL=http://localhost:3000/api
SDK_ENVIRONMENT=sandbox

# ─── MERCHANT PILOT SETTINGS ──────────────────────────────────────────────
# Number of test merchants to target
PILOT_TARGET_MERCHANTS=50
# Enable test payment endpoints
PILOT_TEST_PAYMENTS_ENABLED=true
