# =============================================================================
# Triumph Synergy — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env to version control.
# =============================================================================

# --- Database ---
POSTGRES_PASSWORD=triumph_local_postgres_2026  # Replace for production
POSTGRES_DB=triumph_synergy
# Full Postgres connection string (Replit / standalone deployments).
# In Docker Compose this is auto-built from the parts above.
POSTGRES_URL=postgresql://postgres:triumph_local_postgres_2026@localhost:5432/triumph_synergy
SAIB_POSTGRES_URL=               # optional Citus coordinator override

# --- Auth ---
AUTH_SECRET=triumph_local_auth_secret_32_chars_min_2026  # Replace for production
NEXTAUTH_SECRET=triumph_local_nextauth_secret_32_chars_min_2026  # Replace for production
NEXTAUTH_URL=http://localhost:3000          # Production: https://triumphsynergy.com

# --- Email (Cloudflare Email Routing → jdrains110@gmail.com) ---
EMAIL_DOMAIN=triumphsynergy.com
EMAIL_FROM=saib@triumphsynergy.com          # Sender address for transactional emails
EMAIL_REPLY_TO=support@triumphsynergy.com
EMAIL_ADMIN=admin@triumphsynergy.com
DMARC_REPORT_EMAIL=dmarc@triumphsynergy.com
# SMTP (for outbound sending — use Resend/SendGrid/SES with DKIM key)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=                               # NEVER COMMIT real value

# --- Pi Network ---
PI_API_KEY=local-pi-api-key-placeholder                 # Replace with real key
PI_INTERNAL_API_KEY=local-pi-internal-api-key-placeholder  # Replace with real key
PI_MAINNET_API_KEY=local-pi-mainnet-key-placeholder     # Replace with real key
PI_TESTNET_API_KEY=local-pi-testnet-key-placeholder     # Replace with real key
PI_API_SECRET=local-pi-api-secret-placeholder           # Replace with real key
PI_NETWORK_MODE=mainnet
NEXT_PUBLIC_PI_APP_ID=triumph-synergy
NEXT_PUBLIC_PI_SANDBOX=false

# --- Supabase (optional) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Validation ---
DEFAULT_VALIDATION_KEY=triumph_local_validation_key_replace_before_prod  # Replace for production

# --- Monitoring ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=triumph_grafana_local_2026

# --- Stellar ---
STELLAR_HORIZON_URL=https://api.mainnet.minepi.com
STELLAR_NETWORK_PASSPHRASE=Pi Network

# --- On-chain broadcaster (tokenization-engine) ---
# Set to true ONLY when STELLAR_SECRET_KEY below is a real, funded wallet.
# When false (default), tokens still mint but stellarAnchor.broadcasted=false.
STELLAR_BROADCAST_ENABLED=false
# Stellar S-key for the broadcaster wallet. NEVER COMMIT.
# Generate testnet wallet:  python3 scripts/generate-pi-wallet.py --testnet
# Generate mainnet wallet:  via Pi Browser → Pi Wallet → Show Passphrase, then derive
STELLAR_SECRET_KEY=
STELLAR_TREASURY_ADDRESS=
STELLAR_TX_TIMEOUT_SEC=180

# Phase-1 testnet preset (uncomment to switch the whole stack to testnet):
# PI_NETWORK_MODE=testnet
# STELLAR_HORIZON_URL=https://api.testnet.minepi.com
# STELLAR_NETWORK_PASSPHRASE=Pi Testnet

# --- Triumph Synergy Wallet Addresses ---
# Central Node / Pi Node (identity + on-chain anchoring)
HQ_PI_ADDRESS=GA6Z5STFJZPBDQT5VZSDUTCKLXXB626ONTLRWBJAWYKLH4LKPIZCGL7V
# Payment wallet (mainnet + testnet — receives all Pi payments)
PAYMENT_WALLET_ADDRESS=GDINCI6L7M3J3YTUEMSX3SP2OD7VBJEVX6DTC3BHLD4SD4CMVQ2DVTMF

# --- Pi Mainnet Node (pinetwork/pi-node-docker:organization-mainnet-v1.0-p24.1.0) ---
PI_NODE_POSTGRES_PASSWORD=<strong-password>
PI_NODE_PRIVATE_KEY=          # blank = auto-generated by the container
# Host ports remapped to 315xx so the new mainnet node coexists with testnet2 (314xx)
PI_NODE_HORIZON_PORT=31501
PI_NODE_PEER_PORT=31502
PI_NODE_HISTORY_PORT=31503
# Bridge target: route central-node ↔ pi-bridge-connector to the mainnet node by default
PI_NODE_CONTAINER=triumph-pi-mainnet-node
PI_NODE_FALLBACK_URL=http://host.docker.internal:31501
PI_NODE_PUBLIC_FALLBACK_URL=https://api.mainnet.minepi.com

# --- Public-Site Bridge (Docker Desktop <-> public sites) ---
# Enables real-time bidirectional comms between the local Docker Desktop
# stack and the public sites. Direction A: Docker periodically POSTs ledger
# state to /api/bridge/ingest on each site. Direction B: Docker holds a long
# SSE connection to /api/bridge/stream and receives commands the sites POST
# to /api/bridge/command. Connections are outbound from Docker only, so it
# works behind NAT/CGNAT (Starlink, mobile hotspot, etc.).
#
# Set the SAME PUBLIC_BRIDGE_TOKEN on Docker Desktop and on each public
# site (Replit Secrets + Pi App Studio env). Generate: openssl rand -hex 32
PUBLIC_BRIDGE_URLS=https://triumphsynergy.com,https://Triumph-Synergy.replit.app
PUBLIC_BRIDGE_TOKEN=
PUBLIC_BRIDGE_NODE_ID=docker-desktop-primary
PUBLIC_BRIDGE_PUSH_INTERVAL_S=10

# --- Redis ---
# Used by idempotency middleware and distributed rate limiting.
# In Docker Compose this resolves automatically via service discovery.
# For standalone deployments set to your Redis server URL.
REDIS_URL=redis://localhost:6379

# --- Supernode / Mesh Security ---
# Shared Bearer token required for POST /supernode/join on all supernode containers.
# If unset, the endpoint is unauthenticated (only suitable for isolated dev setups).
# Generate with: openssl rand -hex 32
SUPERNODE_JOIN_SECRET=

# Bearer token required for POST /mesh/register on the sovereign-mesh-hub.
# If unset, the endpoint is protected only by network isolation (internal Docker network).
# Generate with: openssl rand -hex 32
MESH_API_KEY=

# ==============================================================================
# PostgreSQL 16 — Triumph Synergy Database Framework
# ==============================================================================
# Container: 256MB mem_limit, 0.5 CPU — pgvector/pgvector:pg16 image
# Features: vector search (RAG), pg_stat_statements, pgcrypto, UUID OSP, pg_trgm
# Config: docker/postgres/postgresql.conf (shared_buffers=64MB, work_mem=8MB)
# Init scripts: docker/postgres/init/{00-init.sql, 01-pi-ledger.sql, 02-sovereign-payments.sql, 03-saib-enforcement.sql, 04-credit-bureau.sql}
#
# Schemas:
#   - pi_network: ledger, transactions, accounts, dual-value (Pi mainnet SCP 24)
#   - transactions: payment records, receipts, settlement
#   - sovereign: storefronts (22 .pi domains), carts, payment requests, settlements
#   - saib: enforcer receipts, duties log, live ledger cache
#   - vault: tokenization ledger, asset balances
#   - credit: PiCredit scores, events, limits, disputes, sanctions
#   - quantum: Dilithium-5 audit log (quantum-resistant signatures)
#
# GCV: $314,159.00/π (immutable rate, anchored to Pi mainnet SCP Protocol 24)
# All timestamps in UTC. All Pi amounts in π (Stellar base units / 1,000,000).
# ==============================================================================
# Note: Do NOT override these in .env — use PostgreSQL tuning profile:
# - production: 4GB RAM, 2 CPU, max_connections=500 (scale out with Citus)
# - staging: 1GB RAM, 1 CPU, max_connections=200
# - development (Docker Desktop): 256MB RAM, 0.5 CPU (default in docker-compose.yml)

# ==============================================================================
# Pi Network Mainnet Integration
# ==============================================================================
# Official Pi Node Docker: pinetwork/pi-node-docker:organization-mainnet-v1.0-p24.1.0
# Stellar Protocol: 24 (SCP-24)
# stellar-core version: v24.0.0
# Mainnet Horizon: https://api.mainnet.minepi.com
# 
# This stack runs TWO independent Pi nodes:
#  1. triumph-pi-testnet2-node (pi-node-docker:testnet2) → ports 314xx
#  2. triumph-pi-mainnet-node  (pi-node-docker:p24.1.0) → ports 315xx
#
# The mainnet node's Horizon API proxies through nginx at /api/horizon/mainnet
# The testnet2 node proxies at /api/horizon/testnet
#
# Central Node (triumph-central-node:8083) bridges to both via pi-bridge-connector.
# SAIB Live Ledger polls mainnet Horizon every 10s, records all transactions to
# PostgreSQL pi_network.transactions table with GCV USD equivalents.
# ==============================================================================

# ==============================================================================
# SAIB Live Ledger — Real-time Pi Mainnet GCV Feed
# ==============================================================================
# REST: GET /api/saib/live-ledger
# SSE:  GET /api/saib/live-ledger/stream
#
# Every new Pi mainnet ledger (closed ledger) is captured with:
#   - transaction hash
#   - source account
#   - Pi amount
#   - GCV USD equivalent ($314,159/π)
#   - category classification (goods/services/payment/remittance/transfer)
#   - memo analysis
#
# Ring buffer: 500 most recent transactions (30 day TTL via auto-prune)
# Database: saib.live_ledger_snapshot table with indices on ledger_seq, category, recorded_at
# ==============================================================================

# ==============================================================================
# Sovereign Storefronts — All 22 .pi Domains
# ==============================================================================
# Each .pi domain (wingstop.pi, netjets.pi, etc.) is a sovereign e-commerce storefront
# Payment flow:
#   1. Customer browses storefront (Next.js react UI at /sovereign/[tenant])
#   2. Adds items to cart (stored in sovereign.shopping_carts)
#   3. Initiates checkout → Pi SDK v2.0 createPayment()
#   4. Pi App opens, user authorizes → completes on-chain
#   5. triumph-settlement-core webhook receives & records payment
#   6. sovereign.payment_requests marked complete, payment linked to ledger
#   7. SAIB categorizes (goods/services) via memo classification
#   8. PiCredit updated for both buyer + merchant
#
# Nginx routing: requests to wingstop.pi → $subdomain="wingstop" → X-Triumph-Tenant header
# Next.js proxy.ts: rewrites to /sovereign/wingstop?network=mainnet
# ==============================================================================

# ==============================================================================
# Docker Stack — Complete Services
# ==============================================================================
# Core services (always running):
#   - triumph-postgres (pgvector:pg16)
#   - triumph-redis (redis:7-alpine)
#   - triumph-app (Next.js 16 Turbopack)
#   - triumph-nginx (nginx:1.31.1-alpine)
#   - triumph-saib-enforcer (Node.js duty engine + live ledger)
#   - triumph-pi-mainnet-node (pinetwork/pi-node-docker:p24.1.0)
#   - triumph-pi-testnet2-node (pinetwork/pi-node-docker:testnet2)
#   - pi-bridge-connector (Python httpx poller → Redis broadcaster)
#   - plus 10+ additional services (tokenization, governance, settlement, vault, etc.)
#
# Admin tools (opt-in via profile):
#   - triumph-ubuntu-admin (Ubuntu 24.04 with stellar-sdk, jq, nettools)
#     → Start: docker compose --profile tools up -d ubuntu-admin
#     → Enter: docker exec -it triumph-ubuntu-admin bash
#     → CLI: node /admin/pi-admin.js live-ledger, live-ledger-cats, horizon, account, etc.
#
# Legacy sidecars:
#   - triumph-saib-watchdog (Ubuntu 24.04 — monitors + resurrects SAIB on crash)
#   - triumph-guardian-watchdog-nexus (merged ecosystem-guardian + watchdog duties)
# ==============================================================================

# ==============================================================================
# Troubleshooting & Next Steps
# ==============================================================================
# 1. Rebuild app container with sovereign route:
#    docker compose build app && docker compose up -d --force-recreate app
#
# 2. Verify PostgreSQL init scripts loaded:
#    docker exec triumph-postgres psql -U postgres -d triumph_synergy -c "\dt pi_network.*"
#
# 3. Check SAIB live ledger is running:
#    curl http://localhost:8210/live-ledger?limit=5
#
# 4. View live ledger SSE stream:
#    curl -N http://localhost:8210/live-ledger/stream | head -20
#
# 5. Access sovereign storefront:
#    curl -H "Host: wingstop.pi" http://localhost/
#    Should return React HTML (NOT static 5790-byte old HTML)
#
# 6. Check Pi mainnet Horizon:
#    curl https://api.mainnet.minepi.com | jq '.history_latest_ledger'
#
# 7. Full integration test suite:
#    See README.md section "Integration Testing"
# ==============================================================================
