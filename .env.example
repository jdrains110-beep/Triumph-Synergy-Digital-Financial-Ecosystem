# =============================================================================
# Triumph Synergy — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env to version control.
# =============================================================================

# --- Database ---
POSTGRES_PASSWORD=          # Strong random password (32+ chars)
POSTGRES_DB=triumph_synergy

# --- Auth ---
AUTH_SECRET=                # openssl rand -hex 32
NEXTAUTH_SECRET=            # openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3000

# --- Pi Network ---
PI_API_KEY=                 # From Pi Developer Portal
PI_INTERNAL_API_KEY=        # Same or separate internal key
PI_MAINNET_API_KEY=         # Mainnet-specific
PI_TESTNET_API_KEY=         # Testnet-specific
PI_API_SECRET=              # From Pi Developer Portal
PI_NETWORK_MODE=mainnet
NEXT_PUBLIC_PI_APP_ID=triumph-synergy
NEXT_PUBLIC_PI_SANDBOX=false

# --- Supabase (optional) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Validation ---
DEFAULT_VALIDATION_KEY=     # openssl rand -hex 64

# --- Monitoring ---
GRAFANA_USER=               # Grafana admin username
GRAFANA_PASSWORD=           # Grafana admin password (strong)

# --- Stellar ---
STELLAR_HORIZON_URL=https://api.mainnet.minepi.com
STELLAR_NETWORK_PASSPHRASE=Pi Network
